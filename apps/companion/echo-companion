#!/bin/sh
# Echo Companion launcher: system Python (python-gobject, gtk4-layer-shell), no venv needed.
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# Cairo rendering: same pixels for a small face, ~45 MB and about half the CPU of the GL renderer.
export GSK_RENDERER="${GSK_RENDERER:-cairo}"
export PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}"
exec /usr/bin/python3 -m echo_companion "$@"
