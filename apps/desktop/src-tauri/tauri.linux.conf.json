{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "createUpdaterArtifacts": false,
    "shortDescription": "Local-first personal AI",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/linux/256x256.png",
      "icons/linux/512x512.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "recommends": [
          "xdg-utils",
          "xdg-desktop-portal"
        ]
      },
      "rpm": {
        "release": "1",
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3"
        ],
        "recommends": [
          "xdg-utils",
          "xdg-desktop-portal"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
