{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EchoSpeak",
  "version": "11.4.1",
  "identifier": "ai.echospeak.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EchoSpeak",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#f5f8fc",
        "dragDropEnabled": true
      },
      {
        "label": "settings",
        "title": "EchoSpeak Settings",
        "url": "index.html",
        "width": 1080,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#f5f8fc",
        "dragDropEnabled": false
      },
      {
        "label": "setup",
        "title": "EchoSpeak Setup",
        "url": "index.html",
        "width": 1000,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#f5f8fc",
        "dragDropEnabled": false
      },
      {
        "label": "companion",
        "title": "Echo Companion",
        "url": "index.html",
        "width": 320,
        "height": 370,
        "minWidth": 300,
        "minHeight": 340,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "center": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        "desktop-main"
      ],
      "freezePrototype": true,
      "csp": "default-src 'self' tauri: asset:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://127.0.0.1:* ws://127.0.0.1:* https: wss:; img-src 'self' asset: http://asset.localhost data: blob: http://127.0.0.1:* https:; media-src 'self' asset: http://asset.localhost blob: http://127.0.0.1:* https:; font-src 'self' data:; frame-src http://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "EchoSpeak Project",
    "category": "Productivity",
    "shortDescription": "Local-first personal AI for Windows",
    "longDescription": "EchoSpeak is a local-first personal AI with conversational Chat and compact live status for durable work, tools, research, and specialist activity.",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "startMenuFolder": "EchoSpeak",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/installer-header.bmp",
        "sidebarImage": "windows/installer-sidebar.bmp"
      }
    },
    "resources": {
      "backend-dist/": "backend/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwMzRDNURCOUY1OTg5N0IKUldSN2lWbWYyOFUwVUlNWFFIOGtpUEswWmVWMEV5eGlGYmx4RjZVRWV4ays2WVUxY0gwcDRGdTkK",
      "endpoints": [
        "https://github.com/Ty0x7/EchoSpeak/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
